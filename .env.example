# Database Automation Pro - Environment Variables

# Environment profile: dev, test, prod
DAP_ENVIRONMENT=dev

# API settings
DAP_API_HOST=0.0.0.0
DAP_API_PORT=8000
DAP_DEBUG=true

# JWT secret (CHANGE IN PRODUCTION)
DAP_JWT__SECRET_KEY=your-super-secret-key-here

# Database connection (nested with __ delimiter)
DAP_CONNECTIONS__DEFAULT__HOST=localhost
DAP_CONNECTIONS__DEFAULT__PORT=5432
DAP_CONNECTIONS__DEFAULT__DATABASE=postgres
DAP_CONNECTIONS__DEFAULT__USERNAME=postgres
DAP_CONNECTIONS__DEFAULT__PASSWORD=your_password

# Secrets file path (optional)
# DAP_SECRETS_FILE=./secrets.env

# Backup settings
DAP_BACKUP__OUTPUT_DIR=./backups
DAP_BACKUP__RETENTION_DAYS=30
